{
  "name": "firekeep",
  "private": true,
  "version": "1.0.0-beta.1.7",
  "description": "Firekeep desktop coding room.",
  "productName": "Firekeep",
  "author": "Firekeep",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/index.js",
    "web:dev": "node server/index.js",
    "desktop": "electron .",
    "electron:dev": "electron .",
    "electron:start": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "lint": "oxlint",
    "start": "node server/index.js --production",
    "preview": "npm run build && npm run start"
  },
  "build": {
    "appId": "com.firekeep.desktop",
    "productName": "Firekeep",
    "directories": {
      "output": "release-installer"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/assets/**/*",
      "public/**/*",
      "seed/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/firekeep-taskbar.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Firekeep"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^9.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
